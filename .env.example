# ==============================================================================
# GGR-ICMS Environment Variables Template
# Copy to .env.local for local development. NEVER commit .env* files with secrets.
# ==============================================================================

# --- Application Identity & Runtime ---
NEXT_PUBLIC_APP_NAME="GGR-ICMS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000/api/v1"
APP_URL="MY_APP_URL"
APP_ENV="development"
LOG_LEVEL="INFO"

# --- Gemini API (Server-side only) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- Firebase Web Client (Public configuration only; Phase 3) ---
NEXT_PUBLIC_FIREBASE_API_KEY="CHANGE_ME"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="CHANGE_ME"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="CHANGE_ME"
NEXT_PUBLIC_FIREBASE_APP_ID="CHANGE_ME"

# --- Firebase Admin SDK (Server-side only; Phase 3) ---
FIREBASE_PROJECT_ID="CHANGE_ME"
GOOGLE_APPLICATION_CREDENTIALS="/secure/path/service-account.json"

# --- GIS & Spatial Database (Server-side only; Phase 4 & 7) ---
GIS_API_BASE_URL="http://localhost:8000/v1"
DATABASE_URL="postgresql+psycopg://CHANGE_ME"

# --- Google Drive Integration (Server-side only; Phase 8) ---
GOOGLE_DRIVE_ROOT_FOLDER_ID="CHANGE_ME"

