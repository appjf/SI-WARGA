rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && 
        (request.auth.token.role == role || 
         (resource != null && getUserData().roles.hasAny([role])));
    }

    function isSuperAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'SUPER_ADMIN' || getUserData().roles.hasAny(['SUPER_ADMIN']));
    }

    // Default deny-by-default for all collections unless explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin() || hasRole('ADMIN_RW') || hasRole('KETUA_RT'));
      allow create, update: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['roles', 'status']));
      allow delete: if isSuperAdmin();
    }

    // Residents collection
    match /residents/{residentId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || hasRole('ADMIN_RW') || hasRole('KETUA_RT') || hasRole('SEKRETARIS_RT');
    }

    // Households collection
    match /households/{houseId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || hasRole('ADMIN_RW') || hasRole('KETUA_RT') || hasRole('SEKRETARIS_RT');
    }

    // Transactions collection (Finance)
    match /transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || hasRole('BENDAHARA_RT') || hasRole('KETUA_RT');
    }

    // Complaints collection
    match /complaints/{complaintId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.reporterId == request.auth.uid || hasRole('KETUA_RT') || hasRole('PENGURUS') || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // Audit logs: immutable by clients, created by backend Admin SDK
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin() || hasRole('ADMIN_RW');
      allow write: if false;
    }
  }
}
